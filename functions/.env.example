# Copy this file to functions/.env and fill it in. NEVER commit functions/.env.
# Your Firebase Auth UID (Firebase console > Authentication > Users). Needed for the admin page.
OWNER_UID=
# Secrets given to you by each offerwall partner. A network with no secret is rejected.
OFFERWALL_SECRET_NET1=
OFFERWALL_SECRET_NET2=
# Random secret used to sign short-link view tokens. Make it long, for example: openssl rand -hex 32
TOKEN_SECRET=
# Any random text. Used to hash visitor IPs so raw IPs are never stored.
IP_SALT=
